# Dien API key rieng cua ban. Khong chia se file .env da co key.
# Model phai la ten that duoc tai khoan cua ban ho tro.
# Nhieu model: ngan cach bang dau phay, vi du: model-a,model-b

OPENAI_API_KEY=
OPENAI_MODELS=

DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=

GEMINI_API_KEY=
GEMINI_MODELS=

# Cấu hình đánh giá (Evaluation)
# Đường dẫn file JSON kết quả tóm tắt cần đánh giá (tuyệt đối hoặc tương đối)
EVAL_INPUT_JSON=summaries_openai_20260930_140725_ddc8be95.json
# Đường dẫn dataset gốc (CSV/JSON) nếu JSON input thiếu trường document/summary hoặc cần join theo guid/id
EVAL_DATASET_PATH=
# Thư mục xuất kết quả đánh giá (mặc định sẽ tạo thư mục version_YYYYMMDD_HHMMSS bên trong)
EVAL_OUTPUT_DIR=evaluate
# Mô hình HuggingFace dùng cho BertScore (mặc định xlm-roberta-base cho tiếng Việt)
EVAL_BERT_MODEL=xlm-roberta-base
