# Supabase Auth and Postgres (publishable key is safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Server only: used to write private result objects and mint short-lived signed downloads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STUDIO_RESULTS_BUCKET=summora-results

# Use the same Supabase PostgreSQL database for both URLs.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
WEB_ORIGIN=http://localhost:3000
STUDIO_RETENTION_DAYS=30
CRON_SECRET=replace-with-a-long-random-secret

# At least one provider needs a key and a comma-separated list of allowed model IDs.
OPENAI_API_KEY=
OPENAI_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
GEMINI_API_KEY=
GEMINI_MODELS=
