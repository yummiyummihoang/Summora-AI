# Supabase project (safe for browser use: publishable/anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
# Required only for legacy HS256 JWT signing keys; asymmetric JWKS tokens work without it.
SUPABASE_JWT_SECRET=

# Use the same Supabase PostgreSQL database for both URLs.
# Use a direct or session-mode connection so the worker advisory lock stays on one session.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
WEB_ORIGIN=http://localhost:3000
FASTAPI_INTERNAL_URL=http://localhost:8000
STUDIO_DATA_DIR=studio_data
STUDIO_DAILY_TASKS=200
STUDIO_GLOBAL_TASKS=1000
STUDIO_RETENTION_DAYS=30

# At least one provider needs an API key and a comma-separated list of allowed models.
OPENAI_API_KEY=
OPENAI_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-flash
GEMINI_API_KEY=
GEMINI_MODELS=
