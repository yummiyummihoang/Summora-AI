{
  "name": "summora-ai",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @summora/web dev",
    "build": "pnpm --filter @summora/web build",
    "lint": "pnpm --filter @summora/web lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
