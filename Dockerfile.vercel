FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 STUDIO_MODE=online STUDIO_DATA_DIR=/tmp/summora PYTHONPATH=/app/services/api
WORKDIR /app
COPY requirements.lock.txt .
RUN pip install --no-cache-dir -r requirements.lock.txt && useradd --uid 10001 --create-home studio && mkdir -p /tmp/summora && chown -R studio:studio /tmp/summora
COPY services/api/summora ./services/api/summora
COPY services/api/resources ./services/api/resources
USER studio
EXPOSE 80
CMD ["uvicorn", "summora.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "80", "--no-access-log", "--proxy-headers", "--forwarded-allow-ips", "*"]
